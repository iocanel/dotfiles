  # Base rclone config (e.g. Google Drive, NAS etc)
  if ${pkgs.pass}/bin/pass show config/rclone >/dev/null 2>&1; then
    ${pkgs.pass}/bin/pass show config/rclone > $HOME/.config/rclone/rclone.conf
  fi
