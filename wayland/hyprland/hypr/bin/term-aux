#!/bin/bash
PID=$(hyprctl activewindow -j | jq -r .pid)
DIR=$(readlink -f "/proc/$PID/cwd" 2>/dev/null)
[ -d "$DIR" ] || DIR="$HOME"
mon_h=$(hyprctl monitors -j | jq -r ".[] | select(.focused==true) | .height")
[ -n "$mon_h" ] || mon_h=1080
delta=$(( - mon_h / 4 ))
hyprctl dispatch hy3:makegroup v
kitty --title "Auxiliary Terminal" --directory "$DIR" "$@" &
for _ in {1..60}; do
  if [[ "$(hyprctl activewindow -j | jq -r .title)" == "Auxiliary Terminal" ]]; then
    hyprctl dispatch resizeactive 0 "$delta"
    exit 0
  fi
  sleep 0.05
done
